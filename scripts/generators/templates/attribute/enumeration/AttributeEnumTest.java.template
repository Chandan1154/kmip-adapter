  @Override
  protected void assertLookupBehaviour() {
    // TODO: Customize these assertions based on actual enum values and expected lookup behavior
    // Lookup by name/value
    withKmipSpec(
        KmipSpec.UnknownVersion,
        () -> {
          {{ATTRIBUTE_NAME}}.Value byName =
              {{ATTRIBUTE_NAME}}.fromName("X-Enum-Custom");
          {{ATTRIBUTE_NAME}}.Value byVal =
              {{ATTRIBUTE_NAME}}.fromValue(0x80000010);
          assertThat(byName.getDescription()).isEqualTo("X-Enum-Custom");
          assertThat(byVal.getValue()).isEqualTo(0x80000010);
        });

    // Lookup by name/value with unsupported version
    withKmipSpec(
        KmipSpec.UnsupportedVersion,
        () ->
            assertThatThrownBy(
                () -> {{ATTRIBUTE_NAME}}.fromName("X-Enum-Custom")));
  }

  @Override
  protected void assertEnumerationRegistryBehavior() {
    // TODO: Customize these assertions based on actual enum values and expected registry behavior
    // Valid registration requires the 8XXXXXXX (hex) range
    {{ATTRIBUTE_NAME}}.Value custom =
        {{ATTRIBUTE_NAME}}.register(
                0x80000010, "X-Enum-Custom", UNKNOWN_ONLY);
    assertThat(custom.isCustom()).isTrue();
    assertThat(custom.getDescription()).isEqualTo("X-Enum-Custom");

    withKmipSpec(
        KmipSpec.UnknownVersion,
        () -> {
          assertThat(custom.isSupported()).isTrue();
        });
    withKmipSpec(
        KmipSpec.UnsupportedVersion,
        () -> {
          assertThat(custom.isSupported()).isFalse();
        });

    // Negative cases: invalid range, empty description, empty versions
    assertThatThrownBy(
            () -> {{ATTRIBUTE_NAME}}.register(
                0x7FFFFFFF, "Bad-Range", UNKNOWN_ONLY))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(
            () -> {{ATTRIBUTE_NAME}}.register(
                0x00000001, "Bad-Range", UNKNOWN_ONLY))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(
            () ->
                {{ATTRIBUTE_NAME}}.register(
                    0x80000011, "   ", UNKNOWN_ONLY))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(() -> {{ATTRIBUTE_NAME}}.register(
                0x80000012, "X-Empty-Versions", Set.of()))
        .isInstanceOf(IllegalArgumentException.class);
  }
